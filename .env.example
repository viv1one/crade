# MongoDB Atlas connection string (include a default database name)
MONGODB_URI=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Same value as VAPID_PUBLIC_KEY, exposed to the browser
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Email alerts (Resend — https://resend.com, free tier). Without this set,
# alerts created with the "email" channel just fail silently per-alert (see
# notifyUserByEmail in app/api/cron/evaluate-alerts/route.ts) — push alerts
# are unaffected.
RESEND_API_KEY=
# Optional — defaults to Resend's own sandbox sender ("Crade
# <onboarding@resend.dev>"), which works with no domain verification.
RESEND_FROM_EMAIL=

# Shared secret the alert-evaluation scheduler sends when invoking
# /api/cron/evaluate-alerts. Generate any random string, e.g.:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Also set as a repo secret (Settings > Secrets and variables > Actions) —
# see .github/workflows/evaluate-alerts.yml, which pings this endpoint every
# 5 minutes via GitHub Actions (Vercel Hobby's cron only allows once/day).
CRON_SECRET=

# AI providers — router tries them in task-specific order, skipping any
# without a key. See lib/ai/router.ts.
NIM_API_KEY=
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Second, larger NIM-hosted model (same key) — kept as a last-resort
# fallback only, since it measured ~12s per reply vs ~1-2s for the model
# above. See lib/ai/router.ts. Which models a given NIM key can actually
# invoke varies by account — if either default 404s as "Not found for
# account" (not 410 Gone), check what your key has access to.
NIM_MODEL_LARGE=nvidia/nemotron-3-ultra-550b-a55b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
