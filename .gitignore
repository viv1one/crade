# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
*credentials*.env

# vercel
.vercel

# nektos/act (local GitHub Actions testing) — secrets file (per act's own
# recommended convention) and local-only flattened workflow mirrors (a real
# act 0.2.89 parsing bug means the actual .github/workflows/ files can't be
# run through act as-is — see scripts/test-workflows-locally.sh). See
# CLAUDE.md.
.secrets
.act/

# typescript
*.tsbuildinfo
next-env.d.ts
